# Salin file ini jadi ".env" untuk development lokal, isi dengan nilai asli dari
# Supabase Dashboard > Settings > API Keys (lihat PANDUAN.md langkah 4).
# Untuk production di Netlify, isi ini di Site settings > Environment variables (BUKAN di file ini).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
